<?xml version="1.0" encoding="utf-8"?>
<!-- Bubble's widget: the logo and a grid of icons that scrolls up and down; the edge with more
     apps behind it fades out, the only hint that it scrolls. AppsWidget sets the
     number of columns, a compact row height and the icon size (the
     launcher's own) from the widget's real size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- Bubble's logo instead of a written title. -->
    <ImageView
        android:id="@+id/widget_title"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@string/widget_title"
        android:src="@drawable/ic_bubble" />

    <GridView
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadingEdgeLength="28dp"
        android:gravity="center"
        android:numColumns="4"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp" />
</LinearLayout>
