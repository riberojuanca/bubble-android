<?xml version="1.0" encoding="utf-8"?>
<!-- Sees only window changes of the wallpaper app and Google Photos, and never reads their content:
     enough to know that Wallpaper & style opened Google Photos' picker. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/assist_description"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.apps.wallpaper,com.google.android.apps.photos,com.android.wallpaper" />
